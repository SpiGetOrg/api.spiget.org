# Copy to .env and fill in. Empty values fall back to the app defaults

# With host network mode the app binds this port directly on the host
PORT=3012

SERVER_NAME=default
# "master", or anything else for a slave that redirects downloads/webhook registration to MASTER_HOST
SERVER_MODE=master
MASTER_HOST=

# MongoDB: set MONGO_URL, or the individual parts below
MONGO_URL=
MONGO_USER=
MONGO_PASS=
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=spiget

# Required: InfluxDB for request metrics, e.g. http://user:pass@localhost:8086/spiget
INFLUX_URL=

SENTRY_DSN=

# Cloudflare analytics for /v2/metrics
CLOUDFLARE_ZONE=
CLOUDFLARE_KEY=

# User-Agent for proxied spigotmc.org downloads
USER_AGENT=spiget
